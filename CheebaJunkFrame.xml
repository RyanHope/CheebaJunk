<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
  <Script file="CheebaJunkFrame.lua"/>

  <!-- ============================================================
       Tab button template (styled like FishingBuddy / character panel)
       PanelTemplates_SelectTab expects: tabName.."Left/Middle/Right" for inactive,
       tabName.."LeftDisabled/MiddleDisabled/RightDisabled" for active (selected).
  ============================================================ -->
  <Button name="CheebaJunkTabTemplate" virtual="true">
    <Size>
      <AbsDimension x="115" y="32"/>
    </Size>
    <Layers>
      <Layer level="BACKGROUND">
        <!-- Active / selected tab textures (shown when this tab is selected) -->
        <Texture name="$parentLeftDisabled" file="Interface\PaperDollInfoFrame\UI-Character-ActiveTab">
          <Size><AbsDimension x="20" y="32"/></Size>
          <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="0" y="5"/></Offset></Anchor></Anchors>
          <TexCoords left="0" right="0.15625" top="0" bottom="1.0"/>
        </Texture>
        <Texture name="$parentMiddleDisabled" file="Interface\PaperDollInfoFrame\UI-Character-ActiveTab">
          <Size><AbsDimension x="88" y="32"/></Size>
          <Anchors><Anchor point="LEFT" relativeTo="$parentLeftDisabled" relativePoint="RIGHT"/></Anchors>
          <TexCoords left="0.15625" right="0.84375" top="0" bottom="1.0"/>
        </Texture>
        <Texture name="$parentRightDisabled" file="Interface\PaperDollInfoFrame\UI-Character-ActiveTab">
          <Size><AbsDimension x="20" y="32"/></Size>
          <Anchors><Anchor point="LEFT" relativeTo="$parentMiddleDisabled" relativePoint="RIGHT"/></Anchors>
          <TexCoords left="0.84375" right="1.0" top="0" bottom="1.0"/>
        </Texture>
        <!-- Inactive / deselected tab textures -->
        <Texture name="$parentLeft" file="Interface\PaperDollInfoFrame\UI-Character-InActiveTab">
          <Size><AbsDimension x="20" y="32"/></Size>
          <Anchors><Anchor point="TOPLEFT"/></Anchors>
          <TexCoords left="0" right="0.15625" top="0" bottom="1.0"/>
        </Texture>
        <Texture name="$parentMiddle" file="Interface\PaperDollInfoFrame\UI-Character-InActiveTab">
          <Size><AbsDimension x="88" y="32"/></Size>
          <Anchors><Anchor point="LEFT" relativeTo="$parentLeft" relativePoint="RIGHT"/></Anchors>
          <TexCoords left="0.15625" right="0.84375" top="0" bottom="1.0"/>
        </Texture>
        <Texture name="$parentRight" file="Interface\PaperDollInfoFrame\UI-Character-InActiveTab">
          <Size><AbsDimension x="20" y="32"/></Size>
          <Anchors><Anchor point="LEFT" relativeTo="$parentMiddle" relativePoint="RIGHT"/></Anchors>
          <TexCoords left="0.84375" right="1.0" top="0" bottom="1.0"/>
        </Texture>
      </Layer>
    </Layers>
    <NormalText name="$parentText" inherits="GameFontNormalSmall">
      <Anchors><Anchor point="CENTER"><Offset><AbsDimension x="0" y="2"/></Offset></Anchor></Anchors>
    </NormalText>
    <HighlightText name="$parentHighlightText" inherits="GameFontHighlightSmall">
      <Anchors><Anchor point="CENTER"><Offset><AbsDimension x="0" y="2"/></Offset></Anchor></Anchors>
    </HighlightText>
    <DisabledText name="$parentDisabledText" inherits="GameFontHighlightSmall">
      <Anchors><Anchor point="CENTER"><Offset><AbsDimension x="0" y="2"/></Offset></Anchor></Anchors>
    </DisabledText>
    <HighlightTexture name="$parentHighlightTexture" file="Interface\PaperDollInfoFrame\UI-Character-Tab-Highlight" alphaMode="ADD">
      <Anchors>
        <Anchor point="LEFT"><Offset><AbsDimension x="10" y="2"/></Offset></Anchor>
        <Anchor point="RIGHT"><Offset><AbsDimension x="-10" y="2"/></Offset></Anchor>
      </Anchors>
    </HighlightTexture>
    <Scripts>
      <OnLoad>
        this:SetFrameLevel(this:GetFrameLevel() + 4);
      </OnLoad>
      <OnClick>
        CheebaJunkTab_OnClick();
      </OnClick>
      <OnShow>
        PanelTemplates_TabResize(0);
        getglobal(this:GetName().."HighlightTexture"):SetWidth(this:GetTextWidth() + 30);
      </OnShow>
    </Scripts>
  </Button>

  <!-- ============================================================
       Item row template: icon | name text ... | [X] remove button
  ============================================================ -->
  <Button name="CheebaJunkRowTemplate" virtual="true" enableMouse="true">
    <Size>
      <AbsDimension x="288" y="20"/>
    </Size>
    <HighlightTexture file="Interface\Buttons\UI-Listbox-Highlight2" alphaMode="ADD"/>
    <Layers>
      <Layer level="ARTWORK">
        <Texture name="$parentIcon" file="Interface\Icons\INV_Misc_QuestionMark">
          <Size><AbsDimension x="16" y="16"/></Size>
          <Anchors><Anchor point="LEFT"><Offset><AbsDimension x="3" y="0"/></Offset></Anchor></Anchors>
        </Texture>
        <FontString name="$parentName" inherits="GameFontNormalSmall" justifyH="LEFT" text="">
          <Anchors>
            <Anchor point="LEFT" relativeTo="$parentIcon" relativePoint="RIGHT">
              <Offset><AbsDimension x="5" y="0"/></Offset>
            </Anchor>
            <Anchor point="RIGHT" relativeTo="$parentRemove" relativePoint="LEFT">
              <Offset><AbsDimension x="-4" y="0"/></Offset>
            </Anchor>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Frames>
      <Button name="$parentRemove">
        <Size><AbsDimension x="16" y="16"/></Size>
        <Anchors>
          <Anchor point="RIGHT"><Offset><AbsDimension x="-3" y="0"/></Offset></Anchor>
        </Anchors>
        <NormalTexture file="Interface\Buttons\UI-MinusButton-UP"/>
        <PushedTexture file="Interface\Buttons\UI-MinusButton-DOWN"/>
        <HighlightTexture file="Interface\Buttons\UI-PlusButton-Hilight" alphaMode="ADD"/>
        <Scripts>
          <OnClick>
            CheebaJunkRow_OnRemoveClick();
          </OnClick>
        </Scripts>
      </Button>
    </Frames>
    <Scripts>
      <OnEnter>CheebaJunkRow_OnEnter();</OnEnter>
      <OnLeave>CheebaJunkRow_OnLeave();</OnLeave>
    </Scripts>
  </Button>

  <!-- ============================================================
       Main frame
  ============================================================ -->
  <Frame name="CheebaJunkFrame" toplevel="true" movable="true" enableMouse="true" parent="UIParent" hidden="true">
    <Size>
      <AbsDimension x="340" y="390"/>
    </Size>
    <Anchors>
      <Anchor point="CENTER">
        <Offset><AbsDimension x="0" y="100"/></Offset>
      </Anchor>
    </Anchors>

    <Layers>
      <Layer level="ARTWORK">
        <!-- Title -->
        <FontString name="CheebaJunkTitle" inherits="GameFontNormal" text="CheebaJunk">
          <Anchors><Anchor point="TOP"><Offset><AbsDimension x="0" y="-16"/></Offset></Anchor></Anchors>
          <Color r="0.2" g="1.0" b="0.8"/>
        </FontString>
        <!-- Divider line under title -->
        <Texture name="CheebaJunkDivider">
          <Size><AbsDimension x="310" y="1"/></Size>
          <Anchors><Anchor point="TOP"><Offset><AbsDimension x="0" y="-33"/></Offset></Anchor></Anchors>
          <Color r="0.4" g="0.4" b="0.4" a="0.8"/>
        </Texture>
      </Layer>
    </Layers>

    <Frames>
      <!-- Close button -->
      <Button name="CheebaJunkCloseButton" inherits="UIPanelCloseButton">
        <Anchors>
          <Anchor point="TOPRIGHT">
            <Offset><AbsDimension x="-5" y="-4"/></Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnLoad>this:SetFrameLevel(this:GetFrameLevel() + 4);</OnLoad>
        </Scripts>
      </Button>

      <!-- Tab 1: Vendor Items -->
      <Button name="CheebaJunkFrameTab1" inherits="CheebaJunkTabTemplate" id="1">
        <Anchors>
          <Anchor point="CENTER" relativePoint="BOTTOMLEFT">
            <Offset><AbsDimension x="62" y="29"/></Offset>
          </Anchor>
        </Anchors>
      </Button>

      <!-- Tab 2: Delete Items -->
      <Button name="CheebaJunkFrameTab2" inherits="CheebaJunkTabTemplate" id="2">
        <Anchors>
          <Anchor point="LEFT" relativeTo="CheebaJunkFrameTab1" relativePoint="RIGHT">
            <Offset><AbsDimension x="-18" y="0"/></Offset>
          </Anchor>
        </Anchors>
      </Button>

      <!-- "No items" empty state label -->
      <Frame name="CheebaJunkEmptyLabelFrame">
        <Anchors>
          <Anchor point="CENTER"><Offset><AbsDimension x="-15" y="20"/></Offset></Anchor>
        </Anchors>
        <Layers>
          <Layer level="ARTWORK">
            <FontString name="CheebaJunkEmptyLabel" inherits="GameFontNormal" text="No items in this list." hidden="true">
              <Color r="0.5" g="0.5" b="0.5"/>
            </FontString>
          </Layer>
        </Layers>
      </Frame>

      <!-- Scroll frame (provides the scrollbar widget) -->
      <ScrollFrame name="CheebaJunkListScroll" inherits="FauxScrollFrameTemplate">
        <Size>
          <AbsDimension x="20" y="280"/>
        </Size>
        <Anchors>
          <Anchor point="TOPRIGHT">
            <Offset><AbsDimension x="-14" y="-43"/></Offset>
          </Anchor>
        </Anchors>
        <Scripts>
          <OnVerticalScroll>
            FauxScrollFrame_OnVerticalScroll(20, CheebaJunkFrame_Update);
          </OnVerticalScroll>
        </Scripts>
      </ScrollFrame>

      <!-- Item rows (14 visible rows, populated by CheebaJunkFrame_Update) -->
      <Button name="CheebaJunkRow1" inherits="CheebaJunkRowTemplate" hidden="true">
        <Anchors>
          <Anchor point="TOPLEFT"><Offset><AbsDimension x="14" y="-43"/></Offset></Anchor>
        </Anchors>
      </Button>
      <Button name="CheebaJunkRow2" inherits="CheebaJunkRowTemplate" hidden="true">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="CheebaJunkRow1" relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Button>
      <Button name="CheebaJunkRow3" inherits="CheebaJunkRowTemplate" hidden="true">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="CheebaJunkRow2" relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Button>
      <Button name="CheebaJunkRow4" inherits="CheebaJunkRowTemplate" hidden="true">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="CheebaJunkRow3" relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Button>
      <Button name="CheebaJunkRow5" inherits="CheebaJunkRowTemplate" hidden="true">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="CheebaJunkRow4" relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Button>
      <Button name="CheebaJunkRow6" inherits="CheebaJunkRowTemplate" hidden="true">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="CheebaJunkRow5" relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Button>
      <Button name="CheebaJunkRow7" inherits="CheebaJunkRowTemplate" hidden="true">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="CheebaJunkRow6" relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Button>
      <Button name="CheebaJunkRow8" inherits="CheebaJunkRowTemplate" hidden="true">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="CheebaJunkRow7" relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Button>
      <Button name="CheebaJunkRow9" inherits="CheebaJunkRowTemplate" hidden="true">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="CheebaJunkRow8" relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Button>
      <Button name="CheebaJunkRow10" inherits="CheebaJunkRowTemplate" hidden="true">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="CheebaJunkRow9" relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Button>
      <Button name="CheebaJunkRow11" inherits="CheebaJunkRowTemplate" hidden="true">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="CheebaJunkRow10" relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Button>
      <Button name="CheebaJunkRow12" inherits="CheebaJunkRowTemplate" hidden="true">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="CheebaJunkRow11" relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Button>
      <Button name="CheebaJunkRow13" inherits="CheebaJunkRowTemplate" hidden="true">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="CheebaJunkRow12" relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Button>
      <Button name="CheebaJunkRow14" inherits="CheebaJunkRowTemplate" hidden="true">
        <Anchors>
          <Anchor point="TOPLEFT" relativeTo="CheebaJunkRow13" relativePoint="BOTTOMLEFT"/>
        </Anchors>
      </Button>
    </Frames>

    <Scripts>
      <OnLoad>CheebaJunkFrame_OnLoad();</OnLoad>
      <OnEvent>CheebaJunkFrame_OnEvent();</OnEvent>
      <OnShow>CheebaJunkFrame_OnShow();</OnShow>
    </Scripts>
  </Frame>
</Ui>
